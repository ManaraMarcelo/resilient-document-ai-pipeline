# Copy this file to .env and fill in local values. Never commit .env.

# --- Database ---
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/document_ai

# --- Worker ---
WORKER_BATCH_SIZE=10
LLM_MAX_ATTEMPTS=3
LOG_LEVEL=INFO

# --- Primary structured-output provider ---
PRIMARY_PROVIDER_NAME=primary
PRIMARY_PROVIDER_API_KEY=
PRIMARY_PROVIDER_MODEL=

# --- Secondary provider (technical fallback only; leave empty to disable) ---
SECONDARY_PROVIDER_NAME=secondary
SECONDARY_PROVIDER_API_KEY=
SECONDARY_PROVIDER_MODEL=

# --- Tests (disposable database only; tables are dropped and recreated) ---
TEST_DATABASE_URL=
